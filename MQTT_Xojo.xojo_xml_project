   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Constructor(data As MemoryBlock, start As Integer = 0, length As Integer = -1)</SourceLine>
   <SourceLine>// Reads protobuf wire format from data, starting at start, for length bytes (-1 = to the end).</SourceLine>
   <SourceLine>// Nil is read as an empty message (converting "" to a MemoryBlock may give Nil)</SourceLine>
   <SourceLine>If data = Nil Then</SourceLine>
   <SourceLine>mData = New MemoryBlock(0)</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>mData = data</SourceLine>
   <SourceLine>mData.LittleEndian = True</SourceLine>
   <SourceLine>mPos = start</SourceLine>
   <SourceLine>If length &lt; 0 Then</SourceLine>
   <SourceLine>mEnd = data.Size</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>mEnd = start + length</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If mPos &lt; 0 Or mEnd &gt; data.Size Or mPos &gt; mEnd Then</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>mPos = 0</SourceLine>
   <SourceLine>mEnd = 0</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
