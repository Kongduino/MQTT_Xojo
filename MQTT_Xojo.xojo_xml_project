  <ItemParams>channelID As String, channelHash As UInt32, packetID As UInt32, fromNode As UInt32, cipher As String, ByRef portnum As Integer, ByRef dataPayload As String, ByRef requestID As UInt32, ByRef keyName As String</ItemParams>
