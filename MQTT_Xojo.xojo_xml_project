  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SendBoxSetChannels()</SourceLine>
   <SourceLine>// Fills the channel menu with the configured channels and enables Send when the node can send (after connect)</SourceLine>
   <SourceLine>If mChannelMenu = Nil Then Return</SourceLine>
   <SourceLine>mChannelMenu.RemoveAllRows</SourceLine>
   <SourceLine>For c As Integer = 0 To MeshChannelCount() - 1</SourceLine>
   <SourceLine>mChannelMenu.AddRow(MeshChannelName(c))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>If mChannelMenu.RowCount &gt; 0 Then mChannelMenu.SelectedRowIndex = 0</SourceLine>
   <SourceLine>mSendButton.Enabled = AppHasNode() And AppNodeRoot() &lt;&gt; "" And mChannelMenu.RowCount &gt; 0</SourceLine>
   <SourceLine>End Sub</SourceLine>
