   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshDegreesToI(degrees As Double) As Int32</SourceLine>
   <SourceLine>// Degrees to the integer form (1e-7 degrees), truncated toward zero like int() in the converter</SourceLine>
   <SourceLine>Dim scaled As Double = degrees * 10000000.0</SourceLine>
   <SourceLine>If scaled &gt;= 0 Then Return CType(Floor(scaled), Int32)</SourceLine>
   <SourceLine>Return CType(Ceiling(scaled), Int32)</SourceLine>
   <SourceLine>End Function</SourceLine>
