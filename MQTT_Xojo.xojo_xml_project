 <Method>
  <ItemName>X25519Carry</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1018364518</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub X25519Carry(o() As Int64)</SourceLine>
   <SourceLine>// Normalizes limbs to 16 bits (TweetNaCl car25519). The carry out of the top limb wraps around times 38,</SourceLine>
   <SourceLine>// since 2^256 = 38 (mod 2^255 - 19). Floor division, as C's arithmetic shift does for negative values</SourceLine>
   <SourceLine>For i As Integer = 0 To 15</SourceLine>
   <SourceLine>Dim v As Int64 = o(i) + 65536</SourceLine>
   <SourceLine>Dim c As Int64</SourceLine>
   <SourceLine>If v &gt;= 0 Then</SourceLine>
   <SourceLine>c = v \ 65536</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>c = -((65535 - v) \ 65536)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If i &lt; 15 Then</SourceLine>
   <SourceLine>o(i + 1) = o(i + 1) + c - 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>o(0) = o(0) + 38 * (c - 1)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>o(i) = v - c * 65536</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>o() As Int64</ItemParams>
