   <SourceLine>Function MeshKnownKeyCount() As Integer</SourceLine>
   <SourceLine>Dim n As Integer</SourceLine>
   <SourceLine>If mConfigKeys &lt;&gt; Nil Then n = mConfigKeys.KeyCount</SourceLine>
   <SourceLine>If mLearnedKeys &lt;&gt; Nil Then</SourceLine>
   <SourceLine>For Each k As Variant In mLearnedKeys.Keys</SourceLine>
   <SourceLine>If mConfigKeys = Nil Or Not mConfigKeys.HasKey(k) Then n = n + 1</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Return n</SourceLine>
