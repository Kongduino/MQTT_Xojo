  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1524724635</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub AppLog(message As String)</SourceLine>
   <SourceLine>// Appends a line to the window's log. The view follows the newest line only when the user is already at</SourceLine>
   <SourceLine>// the bottom, so scrolling up to read older lines isn't interrupted by new traffic</SourceLine>
   <SourceLine>Dim area As DesktopTextArea = Window1.MessagesArea</SourceLine>
   <SourceLine>Dim lastLine As Integer = area.LineNumber(area.Text.Length)</SourceLine>
   <SourceLine>// the last visible line: the one at a point just inside the bottom-left corner of the control</SourceLine>
   <SourceLine>Dim lastVisible As Integer = area.LineNumber(area.CharacterPosition(4, area.Height - 4))</SourceLine>
   <SourceLine>Dim atBottom As Boolean = (lastVisible &gt;= lastLine - 1)</SourceLine>
   <SourceLine>area.AddText(message + EndOfLine)</SourceLine>
   <SourceLine>If atBottom Then area.VerticalScrollPosition = area.LineNumber(area.Text.Length)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>message As String</ItemParams>
  <ItemResult></ItemResult>
 </Method>
