  </HookInstance>
  <HookInstance>
   <ItemName>MQTTConnectionRefused</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>2042051007</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub MQTTConnectionRefused(reasonCode As Integer)</SourceLine>
    <SourceLine>// CONNACK return codes of MQTT 3.1.1</SourceLine>
    <SourceLine>Dim reason As String</SourceLine>
    <SourceLine>Select Case reasonCode</SourceLine>
    <SourceLine>Case 1</SourceLine>
    <SourceLine>reason = "unacceptable protocol version"</SourceLine>
    <SourceLine>Case 2</SourceLine>
    <SourceLine>reason = "client identifier rejected"</SourceLine>
    <SourceLine>Case 3</SourceLine>
    <SourceLine>reason = "server unavailable"</SourceLine>
    <SourceLine>Case 4</SourceLine>
    <SourceLine>reason = "bad username or password"</SourceLine>
    <SourceLine>Case 5</SourceLine>
    <SourceLine>reason = "not authorized"</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>reason = "unknown reason"</SourceLine>
    <SourceLine>End Select</SourceLine>
    <SourceLine>AppLog("The broker refused the connection: " + reason + " (code " + Str(reasonCode) + ")")</SourceLine>
    <SourceLine>If Not MQTTClient1.IsReconnecting Then AppSetConnectButton(False)</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
  <HookInstance>
