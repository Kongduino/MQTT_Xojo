  <PartID>219805695</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Disconnect()</SourceLine>
   <SourceLine>// Closes the connection on purpose: also cancels any pending or running reconnection</SourceLine>
   <SourceLine>mWantConnected = False</SourceLine>
   <SourceLine>mReconnectTimer.RunMode = Timer.RunModes.Off</SourceLine>
   <SourceLine>If mConnectedMQTT Then</SourceLine>
   <SourceLine>Me.Write(String.ChrByte(&amp;hE0) + String.ChrByte(0))</SourceLine>
   <SourceLine>mConnectedMQTT = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>StopKeepAlive</SourceLine>
   <SourceLine>Me.Close</SourceLine>
   <SourceLine>End Sub</SourceLine>
