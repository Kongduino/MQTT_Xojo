 </Method>
 <Method>
  <ItemName>ProtoVarint</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1527627531</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ProtoVarint(value As UInt64) As String</SourceLine>
   <SourceLine>// Base-128 varint, least significant group first</SourceLine>
   <SourceLine>Dim mb As New MemoryBlock(10)</SourceLine>
   <SourceLine>Dim n As Integer = 0</SourceLine>
   <SourceLine>Dim v As UInt64 = value</SourceLine>
   <SourceLine>Do</SourceLine>
   <SourceLine>Dim b As Integer = CType(v And &amp;h7F, Integer)</SourceLine>
   <SourceLine>v = Bitwise.ShiftRight(v, 7)</SourceLine>
   <SourceLine>If v &lt;&gt; 0 Then b = b Or &amp;h80</SourceLine>
   <SourceLine>mb.UInt8Value(n) = b</SourceLine>
   <SourceLine>n = n + 1</SourceLine>
   <SourceLine>Loop Until v = 0</SourceLine>
   <SourceLine>Return mb.StringValue(0, n)</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>value As UInt64</ItemParams>
  <ItemResult>String</ItemResult>
 </Method>
