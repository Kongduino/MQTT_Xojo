  <IsShared>0</IsShared>
  <ItemParams>gatewayID As String, fromNode As UInt32, toNode As UInt32, packetID As UInt32, hopLimit As Integer, portnum As Integer, payload As String, ByRef envelope As String</ItemParams>
  <ItemResult>String</ItemResult>
 </Method>
