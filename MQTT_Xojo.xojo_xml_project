 <Method>
  <ItemName>MeshParsePSK</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>569218510</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshParsePSK(psk As String, ByRef pskBytes As String) As Boolean</SourceLine>
   <SourceLine>// The PSK formats mqtt-converter accepts: "AQ==" (base64, as the Meshtastic app shows it), "base64:...",</SourceLine>
   <SourceLine>// "0x" + hex, plain hex, "default" or "1" (the default key), "none" or "" (no encryption)</SourceLine>
   <SourceLine>pskBytes = ""</SourceLine>
   <SourceLine>Dim s As String = psk.Trim</SourceLine>
   <SourceLine>If s = "" Or s = "none" Then Return True // case-insensitive, like the converter</SourceLine>
   <SourceLine>If StrComp(s, "default", 0) = 0 Or s = "1" Then</SourceLine>
   <SourceLine>pskBytes = String.ChrByte(1)</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If s.BeginsWith("base64:") Then Return MeshDecodeBase64Strict(s.Middle(7), pskBytes)</SourceLine>
   <SourceLine>If s.BeginsWith("0x") Then Return MeshDecodeHexStrict(s.Middle(2), pskBytes)</SourceLine>
   <SourceLine>If MeshDecodeHexStrict(s, pskBytes) Then Return True</SourceLine>
   <SourceLine>Return MeshDecodeBase64Strict(s, pskBytes)</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>psk As String, ByRef pskBytes As String</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
 <Method>
  <ItemName>MeshDecodeHexStrict</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>492675010</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshDecodeHexStrict(s As String, ByRef bytes As String) As Boolean</SourceLine>
   <SourceLine>// Only an even number of hex digits</SourceLine>
   <SourceLine>Dim re As New RegEx</SourceLine>
   <SourceLine>re.SearchPattern = "^([0-9a-fA-F]{2})+$"</SourceLine>
   <SourceLine>If re.Search(s) = Nil Then Return False</SourceLine>
   <SourceLine>bytes = DecodeHex(s)</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>s As String, ByRef bytes As String</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
 <Method>
  <ItemName>MeshDecodeBase64Strict</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1473143217</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshDecodeBase64Strict(s As String, ByRef bytes As String) As Boolean</SourceLine>
   <SourceLine>// Only well-formed base64 (A-Z a-z 0-9 + /, padded to a multiple of 4)</SourceLine>
   <SourceLine>Dim re As New RegEx</SourceLine>
   <SourceLine>re.SearchPattern = "^[A-Za-z0-9+/]+={0,2}$"</SourceLine>
   <SourceLine>If re.Search(s) = Nil Or s.Length Mod 4 &lt;&gt; 0 Then Return False</SourceLine>
   <SourceLine>bytes = DecodeBase64(s)</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
