 <Method>
  <ItemName>MeshSeenRecently</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>578171326</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshSeenRecently(packetKey As String) As Boolean</SourceLine>
   <SourceLine>// True if the same packet (sender:id) was already seen in the last 10 minutes, otherwise remembers it.</SourceLine>
   <SourceLine>// Gateways can publish a packet more than once, and several gateways can upload the same packet</SourceLine>
   <SourceLine>If packetKey = "" Then Return False</SourceLine>
   <SourceLine>Dim now As Double = System.Microseconds / 1000000</SourceLine>
   <SourceLine>If mSeenPackets = Nil Then mSeenPackets = New Dictionary</SourceLine>
   <SourceLine>For Each k As Variant In mSeenPackets.Keys</SourceLine>
   <SourceLine>If now - mSeenPackets.Value(k).DoubleValue &gt; 600 Then mSeenPackets.Remove(k)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>If mSeenPackets.HasKey(packetKey) Then Return True</SourceLine>
   <SourceLine>mSeenPackets.Value(packetKey) = now</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End Function</SourceLine>
