  <ItemName>X25519Mul</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>370343583</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub X25519Mul(o() As Int64, a() As Int64, b() As Int64)</SourceLine>
   <SourceLine>// o = a * b mod 2^255 - 19 (o may be a or b)</SourceLine>
   <SourceLine>Dim t(30) As Int64</SourceLine>
   <SourceLine>For i As Integer = 0 To 15</SourceLine>
   <SourceLine>For j As Integer = 0 To 15</SourceLine>
   <SourceLine>t(i + j) = t(i + j) + a(i) * b(j)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>For k As Integer = 0 To 14</SourceLine>
   <SourceLine>t(k) = t(k) + 38 * t(k + 16)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>For n As Integer = 0 To 15</SourceLine>
   <SourceLine>o(n) = t(n)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>X25519Carry(o)</SourceLine>
   <SourceLine>X25519Carry(o)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
