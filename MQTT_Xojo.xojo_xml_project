  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshChannelList() As String</SourceLine>
   <SourceLine>// One line per configured channel: name, cipher and channel hash</SourceLine>
   <SourceLine>MeshEnsureChannels</SourceLine>
   <SourceLine>If mChannelNames.Count = 0 Then Return "Channels: none"</SourceLine>
   <SourceLine>Dim lines() As String</SourceLine>
   <SourceLine>For i As Integer = 0 To mChannelNames.LastIndex</SourceLine>
   <SourceLine>Dim key As String = mChannelKeys(i)</SourceLine>
   <SourceLine>Dim cipher As String</SourceLine>
   <SourceLine>If key.Bytes = 0 Then</SourceLine>
   <SourceLine>cipher = "no encryption"</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>cipher = "AES-" + Str(key.Bytes * 8)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>lines.Add("Channel """ + mChannelNames(i) + """: " + cipher + ", hash " + Str(MeshChannelHash(mChannelNames(i), key)))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Return String.FromArray(lines, EndOfLine)</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
