  <PartID>901739436</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ReadVarint() As UInt64</SourceLine>
   <SourceLine>// Up to 10 bytes, 7 bits each, least significant group first</SourceLine>
   <SourceLine>Dim result As UInt64 = 0</SourceLine>
   <SourceLine>Dim shift As Integer = 0</SourceLine>
   <SourceLine>While mPos &lt; mEnd And shift &lt; 64</SourceLine>
   <SourceLine>Dim b As UInt64 = mData.UInt8Value(mPos)</SourceLine>
   <SourceLine>mPos = mPos + 1</SourceLine>
   <SourceLine>result = result Or Bitwise.ShiftLeft(b And &amp;h7F, shift)</SourceLine>
   <SourceLine>If (b And &amp;h80) = 0 Then Return result</SourceLine>
   <SourceLine>shift = shift + 7</SourceLine>
   <SourceLine>Wend</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>Return 0</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult>UInt64</ItemResult>
