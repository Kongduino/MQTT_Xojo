  <PartID>1969941238</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshJSONSelfTest() As String</SourceLine>
   <SourceLine>// Float formatting checked against Python's repr() (expected values generated with Python),</SourceLine>
   <SourceLine>// plus the Val() round trip it relies on</SourceLine>
   <SourceLine>Dim cases() As String = Array("4081999a=4.050000190734863", "3eb33333=0.3499999940395355", "4274cccd=61.20000076293945", "447d1333=1012.2999877929688", "3727c5ac=9.999999747378752e-06", "47f1205a=123456.703125", "c0e80000=-7.25", "43af0000=350.0", "4149999a=12.600000381469727", "40a0a3d7=5.019999980926514", "38d1b717=9.999999747378752e-05", "2edbe6ff=1.000000013351432e-10", "80000000=-0.0", "40c00000=6.0", "3ff851eb851eb852=1.52", "3fef5c28f5c28f5c=0.98", "3f847ae147ae147b=0.01", "3fe8000000000000=0.75", "4341c37937e08000=1e+16", "434aa535d3d0c000=1.5e+16", "4341c37937e07fff=9999999999999998.0", "3fb999999999999a=0.1", "3fd3333333333334=0.30000000000000004", "4019000000000000=6.25", "c040000000000000=-32.0", "430c6bf526340000=1000000000000000.0", "419d6f3454800000=123456789.125")</SourceLine>
   <SourceLine>Dim failures() As String</SourceLine>
   <SourceLine>For Each c As String In cases</SourceLine>
   <SourceLine>Dim cols() As String = c.Split("=")</SourceLine>
   <SourceLine>Dim bits As MemoryBlock = DecodeHex(cols(0))</SourceLine>
   <SourceLine>Dim d As Double</SourceLine>
   <SourceLine>If bits.Size = 4 Then</SourceLine>
   <SourceLine>bits.LittleEndian = False</SourceLine>
   <SourceLine>d = bits.SingleValue(0)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>bits.LittleEndian = False</SourceLine>
   <SourceLine>d = bits.DoubleValue(0)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Dim got As String = MeshJSONFloat(d)</SourceLine>
   <SourceLine>If StrComp(got, cols(1), 0) &lt;&gt; 0 Then failures.Add(cols(1) + " gave " + got)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>If failures.Count = 0 Then Return "JSON float self-test OK (" + cases.Count.ToString + " values)"</SourceLine>
   <SourceLine>Return "JSON float self-test FAILED: " + String.FromArray(failures, "; ")</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
