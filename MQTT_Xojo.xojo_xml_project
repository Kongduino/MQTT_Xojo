  <PartID>739165887</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AppTLSConnectionType() As SSLSocket.SSLConnectionTypes</SourceLine>
   <SourceLine>// broker.tls_version as the SSLSocket connection type. "auto" (SSLv23) negotiates the best version both sides support</SourceLine>
   <SourceLine>Select Case mTLSVersion</SourceLine>
   <SourceLine>Case "1.3"</SourceLine>
   <SourceLine>Return SSLSocket.SSLConnectionTypes.TLSv13</SourceLine>
   <SourceLine>Case "auto"</SourceLine>
   <SourceLine>Return SSLSocket.SSLConnectionTypes.SSLv23</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Return SSLSocket.SSLConnectionTypes.TLSv12</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End Function</SourceLine>
