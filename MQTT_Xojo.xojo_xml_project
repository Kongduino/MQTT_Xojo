   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Skip(wireType As Integer)</SourceLine>
   <SourceLine>// Skips the value of an unknown field</SourceLine>
   <SourceLine>Select Case wireType</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>Call ReadVarint()</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>If mPos + 8 &gt; mEnd Then</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>mPos = mPos + 8</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>Dim start, length As Integer</SourceLine>
   <SourceLine>Call ReadLengthDelimited(start, length)</SourceLine>
   <SourceLine>Case 5</SourceLine>
   <SourceLine>Call ReadFixed32()</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>// Groups (3, 4) are not used by Meshtastic</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End Sub</SourceLine>
