   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshJSONDefault(kind As String) As String</SourceLine>
   <SourceLine>// JSON for a proto3 field that is absent (default value)</SourceLine>
   <SourceLine>Select Case kind</SourceLine>
   <SourceLine>Case "f", "c"</SourceLine>
   <SourceLine>Return "0.0"</SourceLine>
   <SourceLine>Case "t"</SourceLine>
   <SourceLine>Return """"""</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Return "0"</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End Function</SourceLine>
