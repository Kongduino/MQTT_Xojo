  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SetAutoReconnect(enabled As Boolean, maxDelaySeconds As Integer = 60, giveUpAfterSeconds As Integer = 900)</SourceLine>
   <SourceLine>// Reconnect automatically when the connection is lost (also when the first attempt fails): exponential</SourceLine>
   <SourceLine>// back-off 2, 4, 8 ... maxDelaySeconds with +/-20% jitter, giving up after giveUpAfterSeconds without success.</SourceLine>
   <SourceLine>// Not after a refused login (except code 3, server unavailable), a failed TLS handshake, or Disconnect</SourceLine>
   <SourceLine>mAutoReconnect = enabled</SourceLine>
   <SourceLine>mReconnectMaxDelay = Max(2, maxDelaySeconds)</SourceLine>
   <SourceLine>mReconnectGiveUp = Max(10, giveUpAfterSeconds)</SourceLine>
   <SourceLine>End Sub</SourceLine>
