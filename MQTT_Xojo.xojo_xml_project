  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub X25519Swap(p() As Int64, q() As Int64, doSwap As Integer)</SourceLine>
   <SourceLine>// Swaps two field elements when doSwap = 1 (TweetNaCl sel25519)</SourceLine>
   <SourceLine>If doSwap = 0 Then Return</SourceLine>
   <SourceLine>For i As Integer = 0 To 15</SourceLine>
   <SourceLine>Dim t As Int64 = p(i)</SourceLine>
   <SourceLine>p(i) = q(i)</SourceLine>
   <SourceLine>q(i) = t</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End Sub</SourceLine>
