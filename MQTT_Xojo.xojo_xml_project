  <PartID>1890272422</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshNewPacketID() As UInt32</SourceLine>
   <SourceLine>// Random non-zero packet id, as the firmware generates them (it is also part of the encryption nonce)</SourceLine>
   <SourceLine>Dim id As UInt32 = 0</SourceLine>
   <SourceLine>While id = 0</SourceLine>
   <SourceLine>Dim mb As MemoryBlock = Crypto.GenerateRandomBytes(4)</SourceLine>
   <SourceLine>id = mb.UInt32Value(0)</SourceLine>
   <SourceLine>Wend</SourceLine>
   <SourceLine>Return id</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
