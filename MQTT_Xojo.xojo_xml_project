 <Method>
  <ItemName>EncodeRemainingLength</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>834799615</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function EncodeRemainingLength(length As Integer) As String</SourceLine>
   <SourceLine>Dim result As String</SourceLine>
   <SourceLine>Dim x As Integer = length</SourceLine>
   <SourceLine>Do</SourceLine>
   <SourceLine>Dim encodedByte As Integer = x Mod 128</SourceLine>
   <SourceLine>x = x \ 128</SourceLine>
   <SourceLine>If x &gt; 0 Then encodedByte = encodedByte Or &amp;h80</SourceLine>
   <SourceLine>result = result + String.ChrByte(encodedByte)</SourceLine>
   <SourceLine>Loop Until x = 0</SourceLine>
   <SourceLine>Return result</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
