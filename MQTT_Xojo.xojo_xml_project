  <PartID>443668222</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub ConnectionLost(reason As String)</SourceLine>
   <SourceLine>// The connection is dead without a socket error (keep-alive timeout): close it, then reconnect if wanted</SourceLine>
   <SourceLine>StopKeepAlive</SourceLine>
   <SourceLine>mConnectedMQTT = False</SourceLine>
   <SourceLine>mRxBuffer = ""</SourceLine>
   <SourceLine>Me.Close</SourceLine>
   <SourceLine>Dim gaveUp As Boolean</SourceLine>
   <SourceLine>Dim retry As Boolean = ScheduleReconnect(gaveUp)</SourceLine>
   <SourceLine>RaiseEvent Trace("Connection lost: " + reason)</SourceLine>
   <SourceLine>RaiseEvent MQTTDisconnected</SourceLine>
   <SourceLine>If retry Then RaiseEvent Reconnecting(mReconnectAttempt, mReconnectDelay, reason)</SourceLine>
   <SourceLine>If gaveUp Then RaiseEvent ReconnectFailed(reason)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
