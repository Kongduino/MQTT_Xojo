  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>2074726592</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ProtoFieldInt32(field As Integer, value As Int32) As String</SourceLine>
   <SourceLine>// int32: negative values are sign-extended to 64 bits (10-byte varint), as protobuf requires</SourceLine>
   <SourceLine>Dim m As New MemoryBlock(8)</SourceLine>
   <SourceLine>m.LittleEndian = True</SourceLine>
   <SourceLine>m.Int64Value(0) = value</SourceLine>
   <SourceLine>Return ProtoFieldVarint(field, m.UInt64Value(0))</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>field As Integer, value As Int32</ItemParams>
  <ItemResult>String</ItemResult>
