   <SourceLine>Function ReadInt32() As Int32</SourceLine>
   <SourceLine>// int32 fields: negative values arrive as 10-byte varints, keep the low 32 bits</SourceLine>
   <SourceLine>Dim v As UInt64 = ReadVarint()</SourceLine>
