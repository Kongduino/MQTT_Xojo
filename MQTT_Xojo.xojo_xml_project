  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ReadTag(ByRef field As Integer, ByRef wireType As Integer) As Boolean</SourceLine>
   <SourceLine>// Returns False at the end of the message or on malformed data (check Failed)</SourceLine>
   <SourceLine>If mFailed Or mPos &gt;= mEnd Then Return False</SourceLine>
   <SourceLine>Dim tag As UInt64 = ReadVarint()</SourceLine>
   <SourceLine>If mFailed Then Return False</SourceLine>
   <SourceLine>wireType = CType(tag And 7, Integer)</SourceLine>
   <SourceLine>field = CType(Bitwise.ShiftRight(tag, 3), Integer)</SourceLine>
   <SourceLine>If field &lt;= 0 Or field &gt; 536870911 Then</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
