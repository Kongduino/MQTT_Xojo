   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshJSONObject(keys() As String, values() As String) As String</SourceLine>
   <SourceLine>// {"key":value,...} compact, keys sorted by code point like Python's sort_keys</SourceLine>
   <SourceLine>// (sorting the hex of the UTF-8 bytes gives byte order, independent of case and locale)</SourceLine>
   <SourceLine>Dim sortKeys() As String</SourceLine>
   <SourceLine>For Each k As String In keys</SourceLine>
   <SourceLine>sortKeys.Add(EncodeHex(k))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>sortKeys.SortWith(keys, values)</SourceLine>
   <SourceLine>Dim members() As String</SourceLine>
   <SourceLine>For i As Integer = 0 To keys.LastIndex</SourceLine>
   <SourceLine>members.Add(MeshJSONString(keys(i)) + ":" + values(i))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Return "{" + String.FromArray(members, ",") + "}"</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
