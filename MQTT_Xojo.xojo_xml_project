  <PartID>1347928294</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshNodeID(num As UInt32) As String</SourceLine>
   <SourceLine>// Meshtastic node id notation: !aabbccdd, ^all for broadcast</SourceLine>
   <SourceLine>If num = 4294967295 Then Return "^all"</SourceLine>
   <SourceLine>Dim s As String = "0000000" + Hex(num)</SourceLine>
   <SourceLine>s = s.RightBytes(8).Lowercase</SourceLine>
   <SourceLine>Return "!" + s</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
