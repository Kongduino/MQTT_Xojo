  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1569561083</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub X25519Invert(o() As Int64, a() As Int64)</SourceLine>
   <SourceLine>// o = a^(p - 2) = 1 / a (Fermat), TweetNaCl inv25519</SourceLine>
   <SourceLine>Dim c(15) As Int64</SourceLine>
   <SourceLine>X25519Copy(c, a)</SourceLine>
   <SourceLine>For k As Integer = 253 DownTo 0</SourceLine>
   <SourceLine>X25519Mul(c, c, c)</SourceLine>
   <SourceLine>If k &lt;&gt; 2 And k &lt;&gt; 4 Then X25519Mul(c, c, a)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>X25519Copy(o, c)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
