  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshAESBlock(key As String, block As MemoryBlock) As MemoryBlock</SourceLine>
   <SourceLine>// One raw AES block encryption E(key, block), done as CTR over 16 zero bytes with the block as the counter</SourceLine>
   <SourceLine>// (the CTR mode is the one MeshCryptoSelfTest verified; no padding questions). Nil on failure</SourceLine>
   <SourceLine>Dim zeros As New MemoryBlock(16)</SourceLine>
   <SourceLine>Dim result As MemoryBlock = MeshAESCTR(MeshAESKeyForm(key), zeros, block)</SourceLine>
   <SourceLine>If result = Nil Or result.Size &lt; 16 Then Return Nil</SourceLine>
   <SourceLine>Return result</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
