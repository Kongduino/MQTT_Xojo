 <Method>
  <ItemName>X25519Unpack</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>356980582</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub X25519Unpack(o() As Int64, bytes As MemoryBlock)</SourceLine>
   <SourceLine>// 32 little-endian bytes to 16 limbs, top bit ignored</SourceLine>
   <SourceLine>For i As Integer = 0 To 15</SourceLine>
   <SourceLine>o(i) = bytes.UInt8Value(2 * i) + 256 * bytes.UInt8Value(2 * i + 1)</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>o(15) = o(15) And &amp;h7FFF</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
