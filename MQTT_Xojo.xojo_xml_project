   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshChannelIndex(name As String) As Integer</SourceLine>
   <SourceLine>// Exact (case-sensitive) match, as channel names are compared in the firmware</SourceLine>
   <SourceLine>For i As Integer = 0 To mChannelNames.LastIndex</SourceLine>
   <SourceLine>If StrComp(mChannelNames(i), name, 0) = 0 Then Return i</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Return -1</SourceLine>
   <SourceLine>End Function</SourceLine>
