  <PartID>885485627</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ProtoRawBytes(s As String) As String</SourceLine>
   <SourceLine>// The bytes of s without a text encoding, so that concatenating protobuf pieces never converts anything</SourceLine>
   <SourceLine>If s.Bytes = 0 Then Return ""</SourceLine>
   <SourceLine>Dim mb As MemoryBlock = s</SourceLine>
   <SourceLine>Return mb.StringValue(0, mb.Size)</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
