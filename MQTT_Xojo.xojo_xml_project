  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>s As String</ItemParams>
  <ItemResult>String</ItemResult>
 </Method>
 <Method>
  <ItemName>MeshJSONEscape</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>434178879</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshJSONEscape(codeUnit As Integer) As String</SourceLine>
   <SourceLine>// \uxxxx with lowercase hex, as Python writes it</SourceLine>
   <SourceLine>Dim h As String = "000" + Hex(codeUnit)</SourceLine>
   <SourceLine>h = h.Right(4).Lowercase</SourceLine>
   <SourceLine>Return "\u" + h</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
