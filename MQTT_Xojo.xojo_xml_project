  <PartID>506872552</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function X25519PublicKey(privateKey As String) As String</SourceLine>
   <SourceLine>// The public key for a private key: privateKey times the base point u = 9</SourceLine>
   <SourceLine>Dim base As New MemoryBlock(32)</SourceLine>
   <SourceLine>base.UInt8Value(0) = 9</SourceLine>
   <SourceLine>Return X25519(privateKey, base.StringValue(0, 32))</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
