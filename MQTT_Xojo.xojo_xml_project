   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ReadLengthDelimited(ByRef start As Integer, ByRef length As Integer) As Boolean</SourceLine>
   <SourceLine>// Reads the length prefix, returns the slice position and moves past it</SourceLine>
   <SourceLine>Dim n As UInt64 = ReadVarint()</SourceLine>
   <SourceLine>If mFailed Then Return False</SourceLine>
   <SourceLine>If n &gt; CType(mEnd - mPos, UInt64) Then</SourceLine>
   <SourceLine>mFailed = True</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>start = mPos</SourceLine>
   <SourceLine>length = CType(n, Integer)</SourceLine>
   <SourceLine>mPos = mPos + length</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
