  <PartID>638584994</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshRoundDigits(digits As String, p As Integer, up As Boolean, ByRef exp10 As Integer) As String</SourceLine>
   <SourceLine>// First p digits, plus one in the last place if up. A carry (999 -&gt; 1000) moves exp10 up by one</SourceLine>
   <SourceLine>Dim headDigits As String = digits.Left(p)</SourceLine>
   <SourceLine>Dim v As Int64 = headDigits.ToInt64</SourceLine>
   <SourceLine>If up Then v = v + 1</SourceLine>
   <SourceLine>Dim s As String = v.ToString</SourceLine>
   <SourceLine>If s.Length &gt; p Then</SourceLine>
   <SourceLine>s = s.Left(p)</SourceLine>
   <SourceLine>exp10 = exp10 + 1</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Return s</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
