 <Method>
  <ItemName>MeshChannelHash</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>882501633</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function MeshChannelHash(name As String, key As String) As Integer</SourceLine>
   <SourceLine>// The firmware's channel hash (Channels::generateHash): xor of the name bytes, xor-ed with the xor of the key bytes.</SourceLine>
   <SourceLine>// Encrypted packets carry it in MeshPacket.channel</SourceLine>
   <SourceLine>Dim h As Integer = 0</SourceLine>
   <SourceLine>If name.Bytes &gt; 0 Then</SourceLine>
   <SourceLine>Dim nameMB As MemoryBlock = name</SourceLine>
   <SourceLine>For i As Integer = 0 To nameMB.Size - 1</SourceLine>
   <SourceLine>h = Bitwise.BitXor(h, nameMB.UInt8Value(i))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If key.Bytes &gt; 0 Then</SourceLine>
   <SourceLine>Dim keyMB As MemoryBlock = key</SourceLine>
   <SourceLine>For j As Integer = 0 To keyMB.Size - 1</SourceLine>
   <SourceLine>h = Bitwise.BitXor(h, keyMB.UInt8Value(j))</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Return h</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>name As String, key As String</ItemParams>
  <ItemResult>Integer</ItemResult>
