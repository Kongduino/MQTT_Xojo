 <Method>
  <ItemName>AppNodeInfoDue</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1553380134</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AppNodeInfoDue() As Boolean</SourceLine>
   <SourceLine>// The NodeInfo goes out at the first connection of a session, then at most once an hour,</SourceLine>
   <SourceLine>// so that a flapping connection doesn't spam the mesh (nodes send theirs about every 3 hours)</SourceLine>
   <SourceLine>Dim t As Double = System.Microseconds / 1000000</SourceLine>
   <SourceLine>If mLastNodeInfo = 0 Or t - mLastNodeInfo &gt;= 3600 Then</SourceLine>
   <SourceLine>mLastNodeInfo = t</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
