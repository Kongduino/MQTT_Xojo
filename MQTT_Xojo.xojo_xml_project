 <Method>
  <ItemName>HandlePubRel</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>619956223</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub HandlePubRel(body As String)</SourceLine>
   <SourceLine>Dim packetID As Integer = Read16(body, 0)</SourceLine>
   <SourceLine>If mPendingQoS2Topic.HasKey(packetID) Then</SourceLine>
   <SourceLine>RaiseEvent MessageReceived(mPendingQoS2Topic.Value(packetID), mPendingQoS2Payload.Value(packetID), 2, mPendingQoS2Retain.Value(packetID))</SourceLine>
   <SourceLine>mPendingQoS2Topic.Remove(packetID)</SourceLine>
   <SourceLine>mPendingQoS2Payload.Remove(packetID)</SourceLine>
   <SourceLine>mPendingQoS2Retain.Remove(packetID)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>SendPubComp(packetID)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
