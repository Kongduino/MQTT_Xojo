  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub StartKeepAlive()</SourceLine>
   <SourceLine>// The timer ticks every half keep-alive period: PingTimerAction sends PINGREQ and watches for silence</SourceLine>
   <SourceLine>If mKeepAlive &lt;= 0 Then Return</SourceLine>
   <SourceLine>mLastReceived = NowSeconds()</SourceLine>
   <SourceLine>mLastPingSent = mLastReceived</SourceLine>
   <SourceLine>mPingTimer.Period = mKeepAlive * 500</SourceLine>
   <SourceLine>mPingTimer.RunMode = Timer.RunModes.Multiple</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
