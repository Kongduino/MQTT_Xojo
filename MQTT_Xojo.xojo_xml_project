 <Method>
  <ItemName>ScheduleReconnect</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1390102406</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ScheduleReconnect(ByRef gaveUp As Boolean) As Boolean</SourceLine>
   <SourceLine>// Plans the next attempt (back-off with jitter). False when reconnecting is off or not wanted;</SourceLine>
   <SourceLine>// gaveUp = True when the give-up time has passed since the connection was first lost</SourceLine>
   <SourceLine>gaveUp = False</SourceLine>
   <SourceLine>If Not mAutoReconnect Or Not mWantConnected Then Return False</SourceLine>
   <SourceLine>Dim t As Double = NowSeconds()</SourceLine>
   <SourceLine>If mReconnectStarted = 0 Then mReconnectStarted = t</SourceLine>
   <SourceLine>If t - mReconnectStarted &gt; mReconnectGiveUp Then</SourceLine>
   <SourceLine>mWantConnected = False</SourceLine>
   <SourceLine>gaveUp = True</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>mReconnectAttempt = mReconnectAttempt + 1</SourceLine>
   <SourceLine>Dim delay As Double = 2 ^ Min(mReconnectAttempt, 10)</SourceLine>
   <SourceLine>If delay &gt; mReconnectMaxDelay Then delay = mReconnectMaxDelay</SourceLine>
   <SourceLine>delay = delay * (0.8 + 0.4 * System.Random.Number)</SourceLine>
   <SourceLine>mReconnectDelay = Max(1, CType(Round(delay), Integer))</SourceLine>
   <SourceLine>mReconnectTimer.Period = mReconnectDelay * 1000</SourceLine>
   <SourceLine>mReconnectTimer.RunMode = Timer.RunModes.Single</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>ByRef gaveUp As Boolean</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
