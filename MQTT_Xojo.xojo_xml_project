  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function ProtoFieldFixed32(field As Integer, value As UInt32) As String</SourceLine>
   <SourceLine>Dim m As New MemoryBlock(4)</SourceLine>
   <SourceLine>m.LittleEndian = True</SourceLine>
   <SourceLine>m.UInt32Value(0) = value</SourceLine>
   <SourceLine>Return ProtoKey(field, 5) + m.StringValue(0, 4)</SourceLine>
   <SourceLine>End Function</SourceLine>
