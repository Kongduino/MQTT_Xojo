  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function AppConfigFile() As FolderItem</SourceLine>
   <SourceLine>// MQTT_Xojo.config.json, next to the app or in one of its parent folders (up to 6 levels):</SourceLine>
   <SourceLine>// that finds it in the project folder both for debug runs and for builds in "Builds - MQTT_Xojo/&lt;platform&gt;/".</SourceLine>
   <SourceLine>// The file holds the credentials and keys and is excluded from the repository (.gitignore)</SourceLine>
   <SourceLine>Dim folder As FolderItem = App.ExecutableFile.Parent</SourceLine>
   <SourceLine>For level As Integer = 0 To 6</SourceLine>
   <SourceLine>If folder = Nil Then Exit For</SourceLine>
   <SourceLine>Dim f As FolderItem = folder.Child("MQTT_Xojo.config.json")</SourceLine>
   <SourceLine>If f &lt;&gt; Nil And f.Exists Then Return f</SourceLine>
   <SourceLine>folder = folder.Parent</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Return Nil</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
